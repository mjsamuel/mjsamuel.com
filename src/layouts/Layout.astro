---
import "../styles/global.css";
import DarkModeToggle from "../components/DarkModeToggle.astro";
import Analytics from "@vercel/analytics/astro";

const { pageTitle } = Astro.props;
let title = "Matthew Samuel";
if (pageTitle) {
  title = `${pageTitle} | ${title}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <!-- Applies the theme before first paint so dark mode doesn't flash light; DarkModeToggle uses these globals -->
    <script is:inline>
      /** @typedef {'system' | 'dark' | 'light'} Theme */
      /** @return {Theme} */
      const getTheme = () => {
        return localStorage?.getItem("theme") ?? "system";
      };

      const systemDarkMode = window.matchMedia("(prefers-color-scheme: dark)");

      /** @param {Theme} theme */
      const setTheme = (theme) => {
        if (theme === "system") {
          theme = systemDarkMode.matches ? "dark" : "light";
        }

        if (theme === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
      };

      systemDarkMode.addEventListener("change", () => {
        if (getTheme() !== "system") return;
        setTheme("system");
      });

      setTheme(getTheme());
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-background text-primary">
    <main class="flex flex-1 flex-col items-center py-8 sm:py-12 lg:py-16">
      <div class="flex w-full max-w-xl flex-col px-4 sm:px-6 lg:max-w-2xl">
        <!-- Header -->
        <div class="mb-4">
          <h1 class="text-2xl font-bold sm:text-3xl">
            <a href="/">MATTHEW SAMUEL</a>
          </h1>
          <span class="text-secondary">
            developer based in melbourne automating all the things
          </span>
        </div>
        <!-- Content -->
        <slot />
      </div>
    </main>
    <Analytics />
    <footer class="flex justify-center items-center gap-3 text-secondary my-4 text-sm">
      <span>
        © <span id="year">{new Date().getFullYear()}</span> Matthew Samuel
      </span>
      <!-- Build-time year is the fallback; refresh it so a stale build stays current -->
      <script is:inline>
        document.getElementById("year").textContent = new Date().getFullYear();
      </script>
      <DarkModeToggle class="hover:text-primary" />
    </footer>
  </body>
</html>
