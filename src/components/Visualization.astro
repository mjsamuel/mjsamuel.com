<div id="visualization" class="h-full w-full cursor-pointer"></div>

<script>
  import "q5";

  const SQUARE_SIZE = 25;
  const HOVER_RADIUS = 60;
  const HOVER_RING_WIDTH = 5;
  const ECHO_START_RADIUS = SQUARE_SIZE * 2;
  const ECHO_RING_WIDTH = SQUARE_SIZE * 2;
  const ECHO_SPEED = 18;

  // Each role maps to a CSS custom property defined in global.css
  const THEMES = {
    light: {
      background: "--color-background",
      border: "--color-background",
      idle: "--color-primary",
      highlight: "--color-background",
      accent: "--color-accent",
    },
    dark: {
      background: "--color-background",
      border: "--color-secondary",
      idle: "--color-background",
      highlight: "--color-secondary",
      accent: "--color-accent",
    },
  };

  type Theme = typeof THEMES.light;
  type Point = { x: number; y: number };

  // q5's bundled types only declare its API as globals, so describe the
  // instance-mode subset used here
  interface Sketch {
    mouseX: number;
    mouseY: number;
    setup(): void;
    draw(): void;
    windowResized(): void;
    mouseClicked(): void;
    createCanvas(width: number, height: number): void;
    resizeCanvas(width: number, height: number): void;
    background(color: string): void;
    stroke(color: string): void;
    fill(color: string): void;
    square(x: number, y: number, size: number): void;
  }

  const container = document.getElementById("visualization")!;
  const styles = getComputedStyle(document.documentElement);
  const echoes: { center: Point; radius: number }[] = [];

  const resolveColors = (theme: Theme) =>
    Object.fromEntries(
      Object.entries(theme).map(([role, variable]) => [
        role,
        styles.getPropertyValue(variable),
      ]),
    ) as Theme;

  const distance = (a: Point, b: Point) => Math.hypot(a.x - b.x, a.y - b.y);

  const isInEcho = (point: Point) =>
    echoes.some(({ center, radius }) => {
      const d = distance(point, center);
      return d > radius && d < radius + ECHO_RING_WIDTH;
    });

  const sketch = (q: Sketch) => {
    let width = 0;
    let height = 0;
    let columns = 0;
    let rows = 0;
    let cellSize = SQUARE_SIZE;

    // Stretch the squares slightly so whole columns span the full width, then
    // trim the height to whole rows so every cell stays a complete square
    const fitToContainer = () => {
      const bounds = container.getBoundingClientRect();
      width = bounds.width;
      columns = Math.max(1, Math.round(width / SQUARE_SIZE));
      cellSize = width / columns;
      rows = Math.max(1, Math.floor(bounds.height / cellSize));
      height = rows * cellSize;
    };

    const advanceEchoes = () => {
      for (let i = echoes.length - 1; i >= 0; i--) {
        echoes[i].radius += ECHO_SPEED;
        if (echoes[i].radius > Math.hypot(width, height)) echoes.splice(i, 1);
      }
    };

    q.setup = () => {
      fitToContainer();
      q.createCanvas(width, height);
    };

    q.windowResized = () => {
      fitToContainer();
      q.resizeCanvas(width, height);
    };

    q.mouseClicked = () => {
      echoes.push({
        center: { x: q.mouseX, y: q.mouseY },
        radius: ECHO_START_RADIUS,
      });
    };

    q.draw = () => {
      const isDark =
        document.documentElement.getAttribute("data-theme") === "dark";
      const colors = resolveColors(THEMES[isDark ? "dark" : "light"]);

      q.background(colors.background);
      q.stroke(colors.border);
      advanceEchoes();

      // The mouse reports (0, 0) until it first moves over the page
      const mouse = { x: q.mouseX, y: q.mouseY };
      const hasMouse = mouse.x !== 0 || mouse.y !== 0;

      for (let i = 0; i < columns; i++) {
        for (let j = 0; j < rows; j++) {
          const x = i * cellSize;
          const y = j * cellSize;
          const center = { x: x + cellSize / 2, y: y + cellSize / 2 };
          const d = hasMouse ? distance(center, mouse) : Infinity;

          if (d < HOVER_RADIUS) q.fill(colors.highlight);
          else if (d < HOVER_RADIUS + HOVER_RING_WIDTH) q.fill(colors.accent);
          else if (isInEcho(center)) q.fill(colors.highlight);
          else q.fill(colors.idle);

          q.square(x, y, cellSize);
        }
      }
    };
  };

  new Q5(sketch, container);
</script>
