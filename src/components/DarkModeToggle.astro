---
const { class: className } = Astro.props;
---

<button
  id="themeToggle"
  class={`aspect-square flex justify-center items-center size-5 cursor-pointer ${className}`}
  aria-label="Toggle dark mode"
>
  <svg
    class="dark:hidden"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 4h.01"></path>
    <path d="M20 12h.01"></path>
    <path d="M12 20h.01"></path>
    <path d="M4 12h.01"></path>
    <path d="M17.657 6.343h.01"></path>
    <path d="M17.657 17.657h.01"></path>
    <path d="M6.343 17.657h.01"></path>
    <path d="M6.343 6.343h.01"></path>
  </svg>
  <svg
    class="hidden dark:block"
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<!-- getTheme, setTheme and systemDarkMode come from the theme script in Layout's <head> -->
<script is:inline>
  document.getElementById("themeToggle")?.addEventListener("click", () => {
    const prevTheme =
      document.documentElement.getAttribute("data-theme") || "light";
    let newTheme = prevTheme === "dark" ? "light" : "dark";

    const systemTheme = systemDarkMode.matches ? "dark" : "light";
    if (systemTheme === newTheme) {
      newTheme = "system";
    }

    localStorage?.setItem("theme", newTheme);
    setTheme(newTheme);
  });
</script>
